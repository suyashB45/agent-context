# Replace context.example.com with your hostname and set
# AGENT_CONTEXT_PUBLIC_HOST=context.example.com in .env before starting Compose.
# Run Caddy on the host; Compose publishes the application on loopback only.
context.example.com {
    request_body {
        max_size 256KB
    }
    reverse_proxy 127.0.0.1:8765
}
