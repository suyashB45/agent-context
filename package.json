{
  "name": "@suyashb/agent-context",
  "version": "0.4.0",
  "description": "Self-hosted MCP project memory with a React dashboard for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "agent-context": "bin/agent-context.mjs"
  },
  "files": [
    "bin/",
    "build/npm/",
    "examples/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "ROADMAP.md",
    "docs/architecture.md",
    "docs/release.md",
    "docs/clients.md",
    "docs/team.md",
    "docs/README.md",
    "docs/compatibility.md",
    "docs/operations.md",
    "docs/reference.md",
    "docs/troubleshooting.md",
    "docs/website.md",
    "docs/images/"
  ],
  "scripts": {
    "build": "npm run docs:check && npm run build:runtime && npm pack --ignore-scripts --pack-destination dist/npm && npm run release:source && npm run site:build && npm run site:check",
    "start": "node bin/agent-context.mjs dashboard",
    "test": "node --test --test-isolation=none --test-concurrency=1 node-tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "release:source": "node scripts/source-archive.mjs",
    "site:build": "npm run site:prepare && next build --webpack",
    "site:serve": "next dev",
    "site:check": "node scripts/check-site.mjs",
    "prepack": "npm run build:runtime",
    "vercel:build": "npm run build",
    "docs:check": "node scripts/check-docs.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "build:runtime": "node scripts/build.mjs",
    "site:prepare": "node scripts/build-site.mjs",
    "dev": "next dev",
    "site:preview": "node scripts/serve-site.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "esbuild": "0.25.12",
    "framer-motion": "12.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3",
    "next": "16.3.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "agents",
    "context",
    "handoff",
    "react",
    "self-hosted",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyashB45/agent-context.git"
  },
  "bugs": {
    "url": "https://github.com/suyashB45/agent-context/issues"
  },
  "author": {
    "name": "Suyash Balasubramaniam",
    "url": "https://suyashb.me"
  },
  "homepage": "https://agentcontext.suyashb.me"
}
